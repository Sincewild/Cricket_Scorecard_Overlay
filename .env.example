# Required
NODE_ENV=production
ADMIN_TOKEN=change-this-to-a-long-random-secret

# Port — Hostinger VPS: keep 3000, nginx proxies 80/443 -> 3000
PORT=3000

# Optional: pre-load a match on startup (full CricClubs URL)
MATCH_URL=

# Scrape timing (milliseconds)
NORMAL_INTERVAL_MS=20000
POST_OVER_INTERVAL_MS=45000
SCRAPE_TIMEOUT_MS=60000
WAIT_AFTER_LOAD_MS=8000

# Optional: HTTP proxy URL for scraper (e.g. residential proxy to bypass Cloudflare)
PROXY_URL=
