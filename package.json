{
  "name": "cricket-overlay",
  "version": "1.0.0",
  "description": "Production-ready CricClubs live score overlay for YOLOBox Ultra",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node src/index.js",
    "check": "node --check src/index.js",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop cricket-overlay",
    "pm2:restart": "pm2 restart cricket-overlay",
    "pm2:logs": "pm2 logs cricket-overlay",
    "pm2:status": "pm2 status",
    "setup:browser": "npx cloakbrowser install"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^7.1.0",
    "cloakbrowser": "latest",
    "playwright-core": "latest"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
